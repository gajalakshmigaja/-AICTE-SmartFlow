# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=aicte_smartflow
# DB_USER=aicte_admin
# DB_PASSWORD=your_secure_password
# DB_HOST=localhost
# DB_PORT=5432

# Email Configuration (Console email backend in local dev)
DEFAULT_FROM_EMAIL=noreply@aicte-smartflow.gov.in
